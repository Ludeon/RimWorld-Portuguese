<LanguageData>
  
  <!-- EN: firefoam pop pack -->
  <Apparel_FirefoampopPack.label>mochila de espuma anti-fogo</Apparel_FirefoampopPack.label>
  <!-- EN: A utility pack made for firefighters. When triggered, a burst of fire-retardant foam is released, covering a wide circle around its wearer. -->
  <Apparel_FirefoampopPack.description>Uma mochila utilitária feita para bombeiros. Quando acionada, liberta uma descarga de espuma anti-fogo, que cobre um amplo círculo à volta de quem a usa.</Apparel_FirefoampopPack.description>
  <!-- EN: firefoam pop -->
  <Apparel_FirefoampopPack.comps.CompApparelReloadable.chargeNoun>descarga de espuma</Apparel_FirefoampopPack.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <Apparel_FirefoampopPack.comps.CompApparelReloadable.cooldownGerund>em recarga</Apparel_FirefoampopPack.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: pop firefoam -->
  <Apparel_FirefoampopPack.verbs.pop_firefoam.label>libertar espuma anti-fogo</Apparel_FirefoampopPack.verbs.pop_firefoam.label>
  
  <!-- EN: smokepop pack -->
  <Apparel_SmokepopBelt.label>mochila de fumo</Apparel_SmokepopBelt.label>
  <!-- EN: A defensive smokescreen. When activated, it will release a cloud of smoke, obscuring incoming shots and preventing turrets from locking on. -->
  <Apparel_SmokepopBelt.description>Uma cortina de fumo defensiva. Quando ativada, liberta uma nuvem de fumo que dificulta os disparos que chegam e impede as torretas de fixarem o alvo.</Apparel_SmokepopBelt.description>
  <!-- EN: smokepop -->
  <Apparel_SmokepopBelt.comps.CompApparelReloadable.chargeNoun>descarga de fumo</Apparel_SmokepopBelt.comps.CompApparelReloadable.chargeNoun>
  <!-- EN: on cooldown -->
  <Apparel_SmokepopBelt.comps.CompApparelReloadable.cooldownGerund>em recarga</Apparel_SmokepopBelt.comps.CompApparelReloadable.cooldownGerund>
  <!-- EN: pop smoke -->
  <Apparel_SmokepopBelt.verbs.pop_smoke.label>libertar fumo</Apparel_SmokepopBelt.verbs.pop_smoke.label>
  
