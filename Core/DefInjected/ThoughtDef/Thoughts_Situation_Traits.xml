  <PyromaniacNearFire.stages.beautiful_fire.label>fogo bonito</PyromaniacNearFire.stages.beautiful_fire.label>
  <!-- EN: The sinuous flame dances, warm like love, bright like freedom, all-consuming. -->
  <PyromaniacNearFire.stages.beautiful_fire.description>A chama sinuosa dança, quente como o amor, brilhante como a liberdade, consumindo tudo.</PyromaniacNearFire.stages.beautiful_fire.description>
