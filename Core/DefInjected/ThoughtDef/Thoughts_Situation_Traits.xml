  <!-- EN: Ouch... I think something's broken... But what an exquisite feeling! -->
  <MasochistPain.stages.masochist_in_intense_pain.description>Ai... Acho que algo está partido... Mas que sentimento requintado!</MasochistPain.stages.masochist_in_intense_pain.description>
  <!-- EN: masochist in mind-shattering pain -->
  <MasochistPain.stages.masochist_in_mindshattering_pain.label>masoquista com dor lancinante</MasochistPain.stages.masochist_in_mindshattering_pain.label>
