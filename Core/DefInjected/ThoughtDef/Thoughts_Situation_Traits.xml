  <!-- EN: masochist in minor pain -->
  <MasochistPain.stages.masochist_in_minor_pain.label>masoquista com dor ligeira</MasochistPain.stages.masochist_in_minor_pain.label>
  <!-- EN: Ow... Heh heh heh... I could get used to this! -->
  <MasochistPain.stages.masochist_in_minor_pain.description>Ai... He he he... Podia habituar-me a isto!</MasochistPain.stages.masochist_in_minor_pain.description>
  <!-- EN: masochist in serious pain -->
  <MasochistPain.stages.masochist_in_serious_pain.label>masoquista com dor grave</MasochistPain.stages.masochist_in_serious_pain.label>
  <!-- EN: Ughhh... It hurts, but I love it! Keep it coming! -->
  <MasochistPain.stages.masochist_in_serious_pain.description>Aaargh... Dói, mas adoro! Continuem!</MasochistPain.stages.masochist_in_serious_pain.description>
