<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: attended concert -->
  <AttendedConcert.stages.attended_concert.label>assistiu a um concerto</AttendedConcert.stages.attended_concert.label>
  <!-- EN: I enjoyed listening to that performance. -->
  <AttendedConcert.stages.attended_concert.description>Gostei de ouvir aquela atuação.</AttendedConcert.stages.attended_concert.description>
  
  <!-- EN: attended party -->
  <AttendedParty.stages.attended_party.label>foi a uma festa</AttendedParty.stages.attended_party.label>
  <!-- EN: I had a good time at that party. -->
  <AttendedParty.stages.attended_party.description>Diverti-me naquela festa.</AttendedParty.stages.attended_party.description>
  
  <!-- EN: attended wedding -->
  <AttendedWedding.stages.attended_wedding.label>foi a um casamento</AttendedWedding.stages.attended_wedding.label>
  <!-- EN: It was great to see two people come together to build a future like that. -->
  <AttendedWedding.stages.attended_wedding.description>Foi ótimo ver duas pessoas unirem-se para construir um futuro assim.</AttendedWedding.stages.attended_wedding.description>
  
  <!-- EN: encouraging speech -->
  <EncouragingSpeech.stages.encouraging_speech.label>discurso encorajador</EncouragingSpeech.stages.encouraging_speech.label>
  <!-- EN: That speech made me feel like we have a solid path forward. -->
  <EncouragingSpeech.stages.encouraging_speech.description>Esse discurso fez-me sentir que temos um caminho sólido para a frente.</EncouragingSpeech.stages.encouraging_speech.description>
  
  <!-- EN: got married to {0} -->
  <GotMarried.stages.got_married_to.label>casou-se com {0}</GotMarried.stages.got_married_to.label>
  <!-- EN: I got married! It's so wonderful to be starting a new life together! -->
  <GotMarried.stages.got_married_to.description>Casei-me! É tão maravilhoso começar uma nova vida a dois!</GotMarried.stages.got_married_to.description>
  
  <!-- EN: held concert -->
  <HeldConcert.stages.held_concert.label>deu um concerto</HeldConcert.stages.held_concert.label>
  <!-- EN: They loved me. They really loved me. -->
  <HeldConcert.stages.held_concert.description>Adoraram-me. Adoraram-me mesmo.</HeldConcert.stages.held_concert.description>
  
  <!-- EN: inspirational speech -->
  <InspirationalSpeech.stages.inspirational_speech.label>discurso inspirador</InspirationalSpeech.stages.inspirational_speech.label>
  <!-- EN: That speech was moving emotionally and intellectually. I am filled with purpose. -->
  <InspirationalSpeech.stages.inspirational_speech.description>Aquele discurso foi comovente, a nível emocional e intelectual. Estou cheio de determinação.</InspirationalSpeech.stages.inspirational_speech.description>
  
  <!-- EN: terrible speech -->
  <TerribleSpeech.stages.terrible_speech.label>discurso terrível</TerribleSpeech.stages.terrible_speech.label>
  <!-- EN: That speech was atrocious. It made me realize how little hope we really have. -->
  <TerribleSpeech.stages.terrible_speech.description>Esse discurso foi atroz. Fez-me perceber a pouca esperança que realmente temos.</TerribleSpeech.stages.terrible_speech.description>
  
  <!-- EN: uninspiring speech -->
  <UninspiringSpeech.stages.uninspiring_speech.label>discurso sem inspiração</UninspiringSpeech.stages.uninspiring_speech.label>
  <!-- EN: That speech was more awkward than inspiring. If that's who we're listening to, I'm worried. -->
  <UninspiringSpeech.stages.uninspiring_speech.description>Aquele discurso foi mais embaraçoso do que inspirador. Se é esta a pessoa que estamos a ouvir, estou preocupado.</UninspiringSpeech.stages.uninspiring_speech.description>
  
</LanguageData>