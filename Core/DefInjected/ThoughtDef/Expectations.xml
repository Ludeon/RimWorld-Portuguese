<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: sky-high expectations -->
  <Expectations.stages.skyhigh_expectations.label>expectativas altíssimas</Expectations.stages.skyhigh_expectations.label>
  <!-- EN: I should be made very comfortable here. -->
  <Expectations.stages.skyhigh_expectations.description>Deviam proporcionar-me muito conforto aqui.</Expectations.stages.skyhigh_expectations.description>
  <!-- EN: high expectations -->
  <Expectations.stages.high_expectations.label>altas expectativas</Expectations.stages.high_expectations.label>
  <!-- EN: There's no reason I shouldn't have the things I want. -->
  <Expectations.stages.high_expectations.description>Não há razão para não ter as coisas que quero.</Expectations.stages.high_expectations.description>
  <!-- EN: moderate expectations -->
  <Expectations.stages.moderate_expectations.label>expectativas moderadas</Expectations.stages.moderate_expectations.label>
  <!-- EN: I can't expect to be totally pampered. -->
  <Expectations.stages.moderate_expectations.description>Não posso esperar ser totalmente mimado.</Expectations.stages.moderate_expectations.description>
  <!-- EN: low expectations -->
  <Expectations.stages.low_expectations.label>baixas expectativas</Expectations.stages.low_expectations.label>
  <!-- EN: I can't expect great comforts. -->
  <Expectations.stages.low_expectations.description>Não posso esperar grandes confortos.</Expectations.stages.low_expectations.description>
  <!-- EN: very low expectations -->
  <Expectations.stages.very_low_expectations.label>expectativas muito baixas</Expectations.stages.very_low_expectations.label>
  <!-- EN: I need to keep myself strong to survive. -->
  <Expectations.stages.very_low_expectations.description>Preciso de me manter forte para sobreviver.</Expectations.stages.very_low_expectations.description>
  <!-- EN: extremely low expectations -->
  <Expectations.stages.extremely_low_expectations.label>expectativas extremamente baixas</Expectations.stages.extremely_low_expectations.label>
  <!-- EN: I'd better steel myself to survive. -->
  <Expectations.stages.extremely_low_expectations.description>É melhor endurecer-me para sobreviver.</Expectations.stages.extremely_low_expectations.description>
  <!-- EN: noble expectations -->
  <Expectations.stages.noble_expectations.label>expectativas nobres</Expectations.stages.noble_expectations.label>
  <!-- EN: I am above the little people and should be made happy every moment. -->
  <Expectations.stages.noble_expectations.description>Estou acima da plebe e devia ser feliz a todo o momento.</Expectations.stages.noble_expectations.description>
  <!-- EN: royal expectations -->
  <Expectations.stages.royal_expectations.label>expectativas reais</Expectations.stages.royal_expectations.label>
  <!-- EN: My majesty... I can hardly believe it myself. A moment's discomfort is below me. -->
  <Expectations.stages.royal_expectations.description>Majestade... Mal consigo acreditar. Um momento de desconforto está abaixo de mim.</Expectations.stages.royal_expectations.description>
  <!-- EN: elite expectations -->
  <Expectations.stages.elite_expectations.label>expectativas de elite</Expectations.stages.elite_expectations.label>
  <!-- EN: I shouldn't have to endure any inconveniences that distract me from my important role. -->
  <Expectations.stages.elite_expectations.description>Não devia ter de suportar inconvenientes que me distraem do meu importante papel.</Expectations.stages.elite_expectations.description>
  <!-- EN: supreme expectations -->
  <Expectations.stages.supreme_expectations.label>expectativas supremas</Expectations.stages.supreme_expectations.label>
  <!-- EN: My importance here is uncontested, so my comfort must be a critical priority for my people. -->
  <Expectations.stages.supreme_expectations.description>A minha importância aqui é incontestável, pelo que o meu conforto deve ser uma prioridade absoluta para o meu povo.</Expectations.stages.supreme_expectations.description>
  
</LanguageData>