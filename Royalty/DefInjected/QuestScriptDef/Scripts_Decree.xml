<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->[decreeIntro]\n\nYou must build a monument. It is [monumentSize] in size and will require these resources (total value [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[decreeThreatInfo]\n\nYou must keep the monument safe for [keepMonumentTicks_duration] after completion, otherwise [asker_nameDef] will be unhappy.</li>
  -->
  <Decree_BuildMonument.questDescriptionRules.rulesStrings>&lt;li>questDescription->[decreeIntro]\n\nVocê deve construir um monumento. É [monumentSize] em tamanho e exigirá esses recursos (valor total [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\n[DecreeThreatInfo]\n\nVocê deve manter o monumento seguro para [keepMonumentTicks_duration] após a conclusão, caso contrário [asker_nameDef] será infeliz.&lt;/li>\n</Decree_BuildMonument.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->monument decree</li>
  -->
  <Decree_BuildMonument.questNameRules.rulesStrings>&lt;li>questNome->monument decreto&lt;/li>\n</Decree_BuildMonument.questNameRules.rulesStrings>
  <!-- EN: New monument marker arrived -->
  <Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>Novo marcador de monumento chegou</Decree_BuildMonument.LetterLabelNewMonumentMarkerArrived.slateRef>
  <!-- EN: Since the monument marker has been destroyed, a new one has been sent. -->
  <Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>Desde que o marcador do monumento foi destruído, um novo foi enviado.</Decree_BuildMonument.LetterTextNewMonumentMarkerArrived.slateRef>
  <!-- EN: Monument completed -->
  <Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>Monumento concluído</Decree_BuildMonument.LetterLabelMonumentCompleted.slateRef>
  <!-- EN: You have completed construction of the monument.\n\nYou must keep it safe for [keepMonumentTicks_duration], otherwise [asker_nameDef] will be displeased. -->
  <Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>Você concluiu a construção do monumento.\n\nVocê deve mantê-lo seguro para [keepMonumentTicks_duration], caso contrário [asker_nameDef] será desagradado.</Decree_BuildMonument.LetterTextMonumentCompleted.slateRef>
  <!-- EN: Monument destroyed -->
  <Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>Monumento destruído</Decree_BuildMonument.LetterLabelMonumentDestroyed.slateRef>
  <!-- EN: [asker_nameDef] is offended that you allowed the monument to be ruined so soon after completion.\n\n[asker_pronoun] will be unhappy about this. -->
  <Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>[asker_nameDef] é ofendido que você permitiu que o monumento fosse arruinado tão logo após a conclusão.\n\n[asker_pronoun] será infeliz sobre isso.</Decree_BuildMonument.LetterTextMonumentDestroyed.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>Não destrua o monumento para {0}</Decree_BuildMonument.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>Não destrua o monumento para {0}</Decree_BuildMonument.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <Decree_BuildMonument.KeepMonument.slateRef>Guardar monumento Não</Decree_BuildMonument.KeepMonument.slateRef>
  
