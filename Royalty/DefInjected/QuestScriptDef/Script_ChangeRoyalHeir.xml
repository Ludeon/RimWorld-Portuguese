<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->\nIn order to consecrate making [titleHeir_nameFull] the heir of [titleHolder_nameFull]'s title, you must build a monument.\n\nThe monument will be [monumentSize] in size and will require these resources (total value [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\nFailing to finish the monument within 20 days is considered to profane the ritual. Your relations with [asker_factionName] will fall by 25, and the heir will not be changed.\n\nIf the monument is destroyed within [keepMonumentTicks_duration] days after completion, your relations with [asker_factionName] will fall by [goodwillChangeIfMonumentDestroyed].</li>
  -->
  <ChangeRoyalHeir.questDescriptionRules.rulesStrings>
    <li>questDescription->\nPara consagrar a nomeação de [titleHeir_nameFull] como herdeiro do título de [titleHolder_nameFull], tens de construir um monumento.\n\nO monumento terá tamanho [monumentSize] e exigirá estes recursos (valor total [monumentRequiredResourcesMarketValue_money]):\n\n[monumentRequiredResources]\n\nNão terminar o monumento em 20 dias é considerado uma profanação do ritual. As tuas relações com [asker_factionName] descerão 25 e o herdeiro não será alterado.\n\nSe o monumento for destruído nos [keepMonumentTicks_duration] dias seguintes à conclusão, as tuas relações com [asker_factionName] descerão [goodwillChangeIfMonumentDestroyed].</li>
  </ChangeRoyalHeir.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[titleHeir_nameDef]'s inheritance</li>
  -->
  <ChangeRoyalHeir.questNameRules.rulesStrings>
    <li>questName->Herança de [titleHeir_nameDef]</li>
  </ChangeRoyalHeir.questNameRules.rulesStrings>
  <!-- EN: Time left: {0} -->
  <ChangeRoyalHeir.InspectStringTimeLeft.slateRef>Tempo restante: {0}</ChangeRoyalHeir.InspectStringTimeLeft.slateRef>
  <!-- EN: [titleHolder_nameDef]'s heir change failed -->
  <ChangeRoyalHeir.LetterTextAskerOffended.slateRef>Falhou a mudança de herdeiro de [titleHolder_nameDef]</ChangeRoyalHeir.LetterTextAskerOffended.slateRef>
  <!-- EN: [asker_nameDef] is offended that you promised to consecrate the new inheritance, but did not build the monument within the prescribed time.\n\nYou lost 25 goodwill with [asker_faction_name]. -->
  <ChangeRoyalHeir.LetterLabelAskerOffended.slateRef>[asker_nameDef] ofendeu-se por teres prometido consagrar a nova herança, mas não teres construído o monumento dentro do prazo estipulado.\n\nPerdeste 25 de boa vontade com [asker_faction_name].</ChangeRoyalHeir.LetterLabelAskerOffended.slateRef>
  <!-- EN: Title holder died: {SUBJECT_definite} -->
  <ChangeRoyalHeir.LetterLabelTitleHolderDied.slateRef>Titular do título morreu: {SUBJECT_definite}</ChangeRoyalHeir.LetterLabelTitleHolderDied.slateRef>
  <!-- EN: {SUBJECT_definite}, whose heir was in the process of being changed, has died. -->
  <ChangeRoyalHeir.LetterTextTitleHolderDied.slateRef>{SUBJECT_definite}, cujo herdeiro estava a ser alterado, morreu.</ChangeRoyalHeir.LetterTextTitleHolderDied.slateRef>
  <!-- EN: Designated heir died: {SUBJECT_definite} -->
  <ChangeRoyalHeir.LetterLabelDesignatedHeirDied.slateRef>Herdeiro designado morreu: {SUBJECT_definite}</ChangeRoyalHeir.LetterLabelDesignatedHeirDied.slateRef>
  <!-- EN: {SUBJECT_definite}, who was supposed to become heir to a title, has died. -->
  <ChangeRoyalHeir.LetterTextDesignatedHeirDied.slateRef>{SUBJECT_definite}, que ia tornar-se herdeiro de um título, morreu.</ChangeRoyalHeir.LetterTextDesignatedHeirDied.slateRef>
  <!-- EN: Monument destroyed -->
  <ChangeRoyalHeir.LetterLabelMonumentDestroyed.slateRef>Monumento destruído</ChangeRoyalHeir.LetterLabelMonumentDestroyed.slateRef>
  <!-- EN: [asker_nameDef] is offended that you promised to consecrate the new inheritance, but allowed the monument to be ruined soon after completion.\n\nYour relations with [asker_faction_name] have fallen by [goodwillChangeIfMonumentDestroyed]. -->
  <ChangeRoyalHeir.LetterTextMonumentDestroyed.slateRef>[asker_nameDef] ofendeu-se por teres prometido consagrar a nova herança, mas teres deixado o monumento ser arruinado pouco depois de concluído.\n\nAs tuas relações com [asker_faction_name] desceram [goodwillChangeIfMonumentDestroyed].</ChangeRoyalHeir.LetterTextMonumentDestroyed.slateRef>
  <!-- EN: New heir: [titleHeir_nameDef] -->
  <ChangeRoyalHeir.LetterLabelNewHeir.slateRef>Novo herdeiro: [titleHeir_nameDef]</ChangeRoyalHeir.LetterLabelNewHeir.slateRef>
  <!-- EN: [titleHeir_nameDef] is the new heir of [titleHolder_nameDef]. -->
  <ChangeRoyalHeir.LetterTextNewHeir.slateRef>[titleHeir_nameDef] é o novo herdeiro de [titleHolder_nameDef].</ChangeRoyalHeir.LetterTextNewHeir.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <ChangeRoyalHeir.DontDestroyMonumentForDays.slateRef>Não destruas o monumento durante {0}</ChangeRoyalHeir.DontDestroyMonumentForDays.slateRef>
  <!-- EN: Do not destroy the monument for {0} -->
  <ChangeRoyalHeir.DontDestroyMonumentForDaysTip.slateRef>Não destruas o monumento durante {0}</ChangeRoyalHeir.DontDestroyMonumentForDaysTip.slateRef>
  <!-- EN: Keep monument {0} -->
  <ChangeRoyalHeir.KeepMonument.slateRef>Manter monumento {0}</ChangeRoyalHeir.KeepMonument.slateRef>

</LanguageData>