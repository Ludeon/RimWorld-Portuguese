<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: {WEAPON}'s calm thoughts -->
  <BondedThoughtCalm.stages.s_calm_thoughts.label>Os pensamentos calmos</BondedThoughtCalm.stages.s_calm_thoughts.label>
  <!-- EN: {WEAPON}, my bonded weapon, is whispering calming thoughts to me. -->
  <BondedThoughtCalm.stages.s_calm_thoughts.description>A minha arma ligada está a sussurrar pensamentos calmantes para mim.</BondedThoughtCalm.stages.s_calm_thoughts.description>
  <!-- EN: {WEAPON}'s kind thoughts -->
  <BondedThoughtKind.stages.s_kind_thoughts.label>pensamentos amáveis</BondedThoughtKind.stages.s_kind_thoughts.label>
  <!-- EN: {WEAPON}, my bonded weapon, is whispering kind thoughts to me. -->
  <BondedThoughtKind.stages.s_kind_thoughts.description>A minha arma ligada está a sussurrar pensamentos amáveis para mim.</BondedThoughtKind.stages.s_kind_thoughts.description>
  <!-- EN: {WEAPON}'s muttering -->
  <BondedThoughtMuttering.stages.s_muttering.label>Está a murmurar</BondedThoughtMuttering.stages.s_muttering.label>
  <!-- EN: {WEAPON}, my bonded weapon, is muttering in my head. It's hard to ignore sometimes. -->
  <BondedThoughtMuttering.stages.s_muttering.description>A minha arma ligada está a murmurar na minha cabeça. Às vezes é difícil ignorar.</BondedThoughtMuttering.stages.s_muttering.description>
  <!-- EN: {WEAPON}'s wailing -->
  <BondedThoughtWailing.stages.s_wailing.label>Está a lamentar</BondedThoughtWailing.stages.s_wailing.label>
  <!-- EN: {WEAPON}, my bonded weapon, is wailing madly in my head. I wish I could ignore it. -->
  <BondedThoughtWailing.stages.s_wailing.description>A minha arma ligada está a chorar loucamente na minha cabeça. Gostava de poder ignorá-la.</BondedThoughtWailing.stages.s_wailing.description>
  <!-- EN: {WEAPON}'s jealousy -->
  <JealousRage.stages.s_jealousy.label>É ciúme</JealousRage.stages.s_jealousy.label>
  <!-- EN: My bonded weapon {WEAPON} is jealous I am using another weapon. I can feel the rage it is screaming into my head. -->
  <JealousRage.stages.s_jealousy.description>A minha arma ligada está com ciúmes que estou a usar outra arma. Consigo sentir a raiva que está a gritar na minha cabeça.</JealousRage.stages.s_jealousy.description>
  <!-- EN: {WEAPON}'s kill thirst -->
  <KillThirst_Weapon.stages.s_kill_thirst.label>Mata sede</KillThirst_Weapon.stages.s_kill_thirst.label>
  <!-- EN: My bonded weapon {WEAPON} is angry it has gone so long without killing. I can feel its rage. -->
  <KillThirst_Weapon.stages.s_kill_thirst.description>A minha arma ligada está zangada por ter passado tanto tempo sem matar. Consigo sentir a sua raiva.</KillThirst_Weapon.stages.s_kill_thirst.description>
  <!-- EN: {WEAPON}'s kill sorrow -->
  <OnKill_BadThought.stages.s_kill_sorrow.label>Mata a tristeza</OnKill_BadThought.stages.s_kill_sorrow.label>
  <!-- EN: {WEAPON}'s sorrow over its kill is affecting my mind as well. -->
  <OnKill_BadThought.stages.s_kill_sorrow.description>A tristeza pela sua morte também está a afectar a minha mente.</OnKill_BadThought.stages.s_kill_sorrow.description>
  <!-- EN: {WEAPON}'s kill happiness -->
  <OnKill_GoodThought.stages.s_kill_happiness.label>Matar a felicidade</OnKill_GoodThought.stages.s_kill_happiness.label>
  <!-- EN: {WEAPON} was overjoyed with its kill, and I feel some of that too. -->
  <OnKill_GoodThought.stages.s_kill_happiness.description>Também me sinto muito.</OnKill_GoodThought.stages.s_kill_happiness.description>
</LanguageData>
