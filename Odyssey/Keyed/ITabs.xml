<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- Fishing -->
  <!-- EN: do X times -->
  <FishRepeatMode_RepeatCount>fazer X vezes</FishRepeatMode_RepeatCount>
  <!-- EN: do until you have X -->
  <FishRepeatMode_TargetCount>fazer até teres X</FishRepeatMode_TargetCount>
  <!-- EN: do forever -->
  <FishRepeatMode_Forever>fazer para sempre</FishRepeatMode_Forever>
  <!-- EN: Fish population -->
  <FishPopulation>População de peixes</FishPopulation>
  <!-- EN: How many fish are in this body of water. Larger bodies of water have more fish and will recover fish populations faster. -->
  <FishPopulationDesc>Quantos peixes existem nesta massa de água. As massas de água maiores têm mais peixes e recuperam as populações mais depressa.</FishPopulationDesc>
  <!-- EN: Minimum population -->
  <MinimumPopulation>População mínima</MinimumPopulation>
  <!-- EN: Colonists won't fish if the fish population is under this limit. Fishing yields are lower if there are less than 300 fish. -->
  <MinimumPopulationDesc>Os colonos não pescarão se a população de peixes estiver abaixo deste limite. O rendimento da pesca é menor se houver menos de 300 peixes.</MinimumPopulationDesc>
  <!-- EN: uncommon -->
  <Uncommon>incomum</Uncommon>
  <!-- EN: When toggled off, colonists will avoid catching this fish. -->
  <ToggleFishAvoid>Quando desativado, os colonos evitarão apanhar este peixe.</ToggleFishAvoid>
  
</LanguageData>