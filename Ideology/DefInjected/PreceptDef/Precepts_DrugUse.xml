<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: medical only -->
  <DrugUse_MedicalOnly.label>somente médico</DrugUse_MedicalOnly.label>
  <!-- EN: Poisoning the body for recreational purposes is a deeply immoral act. -->
  <DrugUse_MedicalOnly.description>Envenenar o corpo para fins recreativos é um ato profundamente imoral.</DrugUse_MedicalOnly.description>
  <!-- EN: Ingest recreational drug -->
  <DrugUse_MedicalOnly.comps.2.description>Ingestão de drogas recreativas</DrugUse_MedicalOnly.comps.2.description>
  <!-- EN: Administer recreational drug -->
  <DrugUse_MedicalOnly.comps.5.description>Administer droga recreativa</DrugUse_MedicalOnly.comps.5.description>
  <!-- EN: medical or social only -->
  <DrugUse_MedicalOrSocial.label>somente médico ou social</DrugUse_MedicalOrSocial.label>
  <!-- EN: A drink with a smoke is fine, especially with friends, but poisoning the body with powerful chemicals is wrong. -->
  <DrugUse_MedicalOrSocial.description>Uma bebida com uma fumaça é boa, especialmente com amigos, mas envenenar o corpo com produtos químicos poderosos é errado.</DrugUse_MedicalOrSocial.description>
  <!-- EN: Ingest hard drug -->
  <DrugUse_MedicalOrSocial.comps.2.description>Ingestão de drogas duras</DrugUse_MedicalOrSocial.comps.2.description>
  <!-- EN: Administer hard drug -->
  <DrugUse_MedicalOrSocial.comps.5.description>Administer droga dura</DrugUse_MedicalOrSocial.comps.5.description>
  <!-- EN: prohibited -->
  <DrugUse_Prohibited.label>proibido</DrugUse_Prohibited.label>
  <!-- EN: The body should absolutely not be poisoned by chemicals. The only exception is the use of medicine in direct medical care. -->
  <DrugUse_Prohibited.description>O corpo não deve absolutamente ser envenenado por produtos químicos. A única exceção é o uso de medicamentos em cuidados médicos diretos.</DrugUse_Prohibited.description>
  <!-- EN: Ingest drug -->
  <DrugUse_Prohibited.comps.0.description>Ingestão de drogas</DrugUse_Prohibited.comps.0.description>
  <!-- EN: Administer drug -->
  <DrugUse_Prohibited.comps.5.description>Droga de administrador</DrugUse_Prohibited.comps.5.description>
</LanguageData>
