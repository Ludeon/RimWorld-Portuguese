<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: medical only -->
  <DrugUse_MedicalOnly.label>só para fins médicos</DrugUse_MedicalOnly.label>
  <!-- EN: Poisoning the body for recreational purposes is a deeply immoral act. -->
  <DrugUse_MedicalOnly.description>Envenenar o corpo para fins recreativos é um ato profundamente imoral.</DrugUse_MedicalOnly.description>
  <!-- EN: Ingest recreational drug -->
  <DrugUse_MedicalOnly.comps.2.description>Consumir droga recreativa</DrugUse_MedicalOnly.comps.2.description>
  <!-- EN: Administer recreational drug -->
  <DrugUse_MedicalOnly.comps.5.description>Administrar droga recreativa</DrugUse_MedicalOnly.comps.5.description>
  
  <!-- EN: medical or social only -->
  <DrugUse_MedicalOrSocial.label>só para fins médicos ou sociais</DrugUse_MedicalOrSocial.label>
  <!-- EN: A drink with a smoke is fine, especially with friends, but poisoning the body with powerful chemicals is wrong. -->
  <DrugUse_MedicalOrSocial.description>Uma bebida e um cigarro são aceitáveis, sobretudo entre amigos, mas envenenar o corpo com químicos potentes é errado.</DrugUse_MedicalOrSocial.description>
  <!-- EN: Ingest hard drug -->
  <DrugUse_MedicalOrSocial.comps.2.description>Consumir droga dura</DrugUse_MedicalOrSocial.comps.2.description>
  <!-- EN: Administer hard drug -->
  <DrugUse_MedicalOrSocial.comps.5.description>Administrar droga dura</DrugUse_MedicalOrSocial.comps.5.description>
  
  <!-- EN: prohibited -->
  <DrugUse_Prohibited.label>proibido</DrugUse_Prohibited.label>
  <!-- EN: The body should absolutely not be poisoned by chemicals. The only exception is the use of medicine in direct medical care. -->
  <DrugUse_Prohibited.description>O corpo não deve, de modo algum, ser envenenado por químicos. A única exceção é o uso de medicamentos em tratamento médico direto.</DrugUse_Prohibited.description>
  <!-- EN: Ingest drug -->
  <DrugUse_Prohibited.comps.0.description>Consumir droga</DrugUse_Prohibited.comps.0.description>
  <!-- EN: Administer drug -->
  <DrugUse_Prohibited.comps.5.description>Administrar droga</DrugUse_Prohibited.comps.5.description>
  
</LanguageData>