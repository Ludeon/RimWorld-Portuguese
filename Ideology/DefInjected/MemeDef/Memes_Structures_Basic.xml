  <!-- EN: ideological -->
  <Structure_Ideological.label>ideologia</Structure_Ideological.label>
  <!-- EN: There are no gods. The moral structure of the universe is found in our grand narrative of social forces. -->
  <Structure_Ideological.description>Não há deuses. A estrutura moral do universo é encontrada na nossa grande narrativa das forças sociais.</Structure_Ideological.description>
