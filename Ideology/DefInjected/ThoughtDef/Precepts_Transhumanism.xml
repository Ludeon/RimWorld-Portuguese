<LanguageData>
  <!-- EN: harmful aging -->
  <AgeReversalDemanded.stages.harmful_aging.label>envelhecimento prejudicial</AgeReversalDemanded.stages.harmful_aging.label>
  <!-- EN: I'm getting old. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.harmful_aging.description>Estou a ficar velho. Devia ter uma inversão de idade numa cápsula de bioesculpir.</AgeReversalDemanded.stages.harmful_aging.description>
  <!-- EN: terrible aging -->
  <AgeReversalDemanded.stages.terrible_aging.label>terrível envelhecimento</AgeReversalDemanded.stages.terrible_aging.label>
  <!-- EN: My youth is draining away. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.terrible_aging.description>A minha juventude está a drenar. Devia ter uma inversão de idade numa cápsula de bioesculpir.</AgeReversalDemanded.stages.terrible_aging.description>
  <!-- EN: horrific aging -->
  <AgeReversalDemanded.stages.horrific_aging.label>envelhecimento horrível</AgeReversalDemanded.stages.horrific_aging.label>
  <!-- EN: I am trapped in a decaying prison of flesh! I need to get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.horrific_aging.description>Estou preso numa prisão decadente de carne! Preciso de uma inversão de idade numa cápsula de bioesculpir.</AgeReversalDemanded.stages.horrific_aging.description>
  <!-- EN: received age reversal -->
  <AgeReversalReceived.stages.received_age_reversal.label>recebido idade reversal</AgeReversalReceived.stages.received_age_reversal.label>
  <!-- EN: Aging and death have no hold on me. I am forever, as an enhanced human ought to be. -->
  <AgeReversalReceived.stages.received_age_reversal.description>O envelhecimento e a morte não têm nenhum problema comigo. Eu sou para sempre, como um humano melhorado deve ser.</AgeReversalReceived.stages.received_age_reversal.description>
  <!-- EN: used biosculpter pod -->
  <BioSculpterDespised.stages.used_biosculpter_pod.label>pod de bioesculpter usado</BioSculpterDespised.stages.used_biosculpter_pod.label>
  <!-- EN: My body was despoiled by the use of a biosculpter pod. -->
  <BioSculpterDespised.stages.used_biosculpter_pod.description>O meu corpo foi desprezado pelo uso de uma cápsula de biosculpter.</BioSculpterDespised.stages.used_biosculpter_pod.description>
  <!-- EN: want neural supercharge -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.label>quer sobrecarga neural</NeedNeuralSupercharge.stages.want_neural_supercharge.label>
  <!-- EN: Without a neural supercharge, I'm running below my true capacity. It's depressing. -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.description>Sem uma sobrecarga neural, estou a correr abaixo da minha verdadeira capacidade. É deprimente.</NeedNeuralSupercharge.stages.want_neural_supercharge.description>
  <!-- EN: used sleep accelerator -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>acelerador de sono usado</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>
  <!-- EN: I slept with a sleep accelerator. It's helping me attain my true potential, as one should. -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>Dormi com um acelerador de sono. Está a ajudar-me a atingir o meu verdadeiro potencial.</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>
