<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: revered bloodfeeder -->
  <Bloodfeeder_ReveredBloodfeeder.stages.revered_bloodfeeder.label>hematófago reverenciado</Bloodfeeder_ReveredBloodfeeder.stages.revered_bloodfeeder.label>
  <!-- EN: Let them worship me. Feeding upon them places them below me, as animals are below humans. -->
  <Bloodfeeder_ReveredBloodfeeder.stages.revered_bloodfeeder.description>Que me adorem. Alimentar-me deles coloca-os abaixo de mim, tal como os animais estão abaixo dos humanos.</Bloodfeeder_ReveredBloodfeeder.stages.revered_bloodfeeder.description>
  
  <!-- EN: bloodfeeder self hatred -->
  <Bloodfeeder_ReviledBloodfeeder.stages.bloodfeeder_self_hatred.label>ódio a mim próprio</Bloodfeeder_ReviledBloodfeeder.stages.bloodfeeder_self_hatred.label>
  <!-- EN: I am what I hate. I must rid myself of this curse. -->
  <Bloodfeeder_ReviledBloodfeeder.stages.bloodfeeder_self_hatred.description>Sou o que odeio. Tenho de me livrar desta maldição.</Bloodfeeder_ReviledBloodfeeder.stages.bloodfeeder_self_hatred.description>
  
  <!-- EN: no bloodfeeders -->
  <BloodfeederColonist_Revered.stages.no_bloodfeeders.label>sem hematófagos</BloodfeederColonist_Revered.stages.no_bloodfeeders.label>
  <!-- EN: Without a bloodfeeder master, we are undirected and lost. We should make a bloodfeeder our leader. -->
  <BloodfeederColonist_Revered.stages.no_bloodfeeders.description>Sem um mestre hematófago, estamos sem rumo e perdidos. Devíamos fazer de um hematófago o nosso líder.</BloodfeederColonist_Revered.stages.no_bloodfeeders.description>
  <!-- EN: no bloodfeeder master -->
  <BloodfeederColonist_Revered.stages.no_bloodfeeder_master.label>sem mestre hematófago</BloodfeederColonist_Revered.stages.no_bloodfeeder_master.label>
  <!-- EN: Without a bloodfeeder master, we lack proper direction. We should make a bloodfeeder our leader. -->
  <BloodfeederColonist_Revered.stages.no_bloodfeeder_master.description>Sem um mestre hematófago, falta-nos a orientação certa. Devíamos fazer de um hematófago o nosso líder.</BloodfeederColonist_Revered.stages.no_bloodfeeder_master.description>
  <!-- EN: bloodfeeder master -->
  <BloodfeederColonist_Revered.stages.bloodfeeder_master.label>mestre hematófago</BloodfeederColonist_Revered.stages.bloodfeeder_master.label>
  <!-- EN: The bloodfeeder's presence is a great honor. May they live forever. -->
  <BloodfeederColonist_Revered.stages.bloodfeeder_master.description>A presença do hematófago é uma grande honra. Que viva para sempre.</BloodfeederColonist_Revered.stages.bloodfeeder_master.description>
  
  <!-- EN: bloodfeeder among us -->
  <BloodfeederColonist_Reviled.stages.bloodfeeder_among_us.label>hematófago entre nós</BloodfeederColonist_Reviled.stages.bloodfeeder_among_us.label>
  <!-- EN: One of them walks among us. We should expel the bloodfeeder from our home. -->
  <BloodfeederColonist_Reviled.stages.bloodfeeder_among_us.description>Um deles anda entre nós. Devíamos expulsar o hematófago da nossa casa.</BloodfeederColonist_Reviled.stages.bloodfeeder_among_us.description>
  
  <!-- EN: bloodfeeder died -->
  <BloodfeederDied_Revered.stages.bloodfeeder_died.label>hematófago morreu</BloodfeederDied_Revered.stages.bloodfeeder_died.label>
  <!-- EN: The bloodfeeders stand above us, yet one has died here. We will surely be punished for this. -->
  <BloodfeederDied_Revered.stages.bloodfeeder_died.description>Os hematófagos estão acima de nós, e no entanto um morreu aqui. Seremos certamente punidos por isso.</BloodfeederDied_Revered.stages.bloodfeeder_died.description>
  
  <!-- EN: bloodfeeder died -->
  <BloodfeederDied_Reviled.stages.bloodfeeder_died.label>hematófago morreu</BloodfeederDied_Reviled.stages.bloodfeeder_died.label>
  <!-- EN: The only good bloodfeeder is a dead one. -->
  <BloodfeederDied_Reviled.stages.bloodfeeder_died.description>O único hematófago bom é o hematófago morto.</BloodfeederDied_Reviled.stages.bloodfeeder_died.description>
  
  <!-- EN: bloodfeeder -->
  <Bloodfeeders_Revered_Opinion_Bloodfeeder.stages.bloodfeeder.label>hematófago</Bloodfeeders_Revered_Opinion_Bloodfeeder.stages.bloodfeeder.label>
  
  <!-- EN: bloodfeeder -->
  <Bloodfeeders_Reviled_Opinion_Bloodfeeder.stages.bloodfeeder.label>hematófago</Bloodfeeders_Reviled_Opinion_Bloodfeeder.stages.bloodfeeder.label>
  
