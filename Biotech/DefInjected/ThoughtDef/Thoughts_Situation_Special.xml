<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: blood torch -->
  <BloodTorch.stages.blood_torch.label>tocha de sangue</BloodTorch.stages.blood_torch.label>
  <!-- EN: No flame burns as softly as a blood torch. -->
  <BloodTorch.stages.blood_torch.description>Nenhuma chama arde tão suavemente como uma tocha de sangue.</BloodTorch.stages.blood_torch.description>
  
  <!-- EN: childlike joy -->
  <ChildlikePositivity.stages.childlike_joy.label>alegria infantil</ChildlikePositivity.stages.childlike_joy.label>
  <!-- EN: New! Fun! Pretty! Oooh! -->
  <ChildlikePositivity.stages.childlike_joy.description>Novo! Divertido! Bonito! Ooooh!</ChildlikePositivity.stages.childlike_joy.description>
  <!-- EN: childlike wonder -->
  <ChildlikePositivity.stages.childlike_wonder.label>maravilha infantil</ChildlikePositivity.stages.childlike_wonder.label>
  <!-- EN: The world is a magical place and I can't wait to grow up! -->
  <ChildlikePositivity.stages.childlike_wonder.description>O mundo é um lugar mágico e mal posso esperar por crescer!</ChildlikePositivity.stages.childlike_wonder.description>
  <!-- EN: childlike enthusiasm -->
  <ChildlikePositivity.stages.childlike_enthusiasm.label>entusiasmo infantil</ChildlikePositivity.stages.childlike_enthusiasm.label>
  <!-- EN: The world is full of wonders. -->
  <ChildlikePositivity.stages.childlike_enthusiasm.description>O mundo está cheio de maravilhas.</ChildlikePositivity.stages.childlike_enthusiasm.description>
  <!-- EN: childlike confidence -->
  <ChildlikePositivity.stages.childlike_confidence.label>confiança infantil</ChildlikePositivity.stages.childlike_confidence.label>
  <!-- EN: There are so many interesting things to learn. -->
  <ChildlikePositivity.stages.childlike_confidence.description>Há tantas coisas interessantes para aprender.</ChildlikePositivity.stages.childlike_confidence.description>
  
  <!-- EN: deathrested outside -->
  <DeathrestChamber.stages.deathrested_outside.label>sono mortal no exterior</DeathrestChamber.stages.deathrested_outside.label>
  <!-- EN: I had to deathrest outdoors. It was awful. -->
  <DeathrestChamber.stages.deathrested_outside.description>Tive de fazer sono mortal ao ar livre. Foi horrível.</DeathrestChamber.stages.deathrested_outside.description>
  <!-- EN: awful deathrest chamber -->
  <DeathrestChamber.stages.awful_deathrest_chamber.label>câmara de sono mortal horrível</DeathrestChamber.stages.awful_deathrest_chamber.label>
  <!-- EN: I had to deathrest in an awful chamber. -->
  <DeathrestChamber.stages.awful_deathrest_chamber.description>Tive de fazer sono mortal numa câmara horrível.</DeathrestChamber.stages.awful_deathrest_chamber.description>
  <!-- EN: decent deathrest chamber -->
  <DeathrestChamber.stages.decent_deathrest_chamber.label>câmara de sono mortal decente</DeathrestChamber.stages.decent_deathrest_chamber.label>
  <!-- EN: I deathrested in a decent chamber. -->
  <DeathrestChamber.stages.decent_deathrest_chamber.description>Fiz sono mortal numa câmara decente.</DeathrestChamber.stages.decent_deathrest_chamber.description>
  <!-- EN: good deathrest chamber -->
  <DeathrestChamber.stages.good_deathrest_chamber.label>boa câmara de sono mortal</DeathrestChamber.stages.good_deathrest_chamber.label>
  <!-- EN: I deathrested in a slightly impressive chamber. It was nice. -->
  <DeathrestChamber.stages.good_deathrest_chamber.description>Fiz sono mortal numa câmara ligeiramente impressionante. Foi agradável.</DeathrestChamber.stages.good_deathrest_chamber.description>
  <!-- EN: great deathrest chamber -->
  <DeathrestChamber.stages.great_deathrest_chamber.label>ótima câmara de sono mortal</DeathrestChamber.stages.great_deathrest_chamber.label>
  <!-- EN: I deathrested in an impressive chamber. I feel rejuvenated. -->
  <DeathrestChamber.stages.great_deathrest_chamber.description>Fiz sono mortal numa câmara impressionante. Sinto o corpo rejuvenescido.</DeathrestChamber.stages.great_deathrest_chamber.description>
  <!-- EN: excellent deathrest chamber -->
  <DeathrestChamber.stages.excellent_deathrest_chamber.label>excelente câmara de sono mortal</DeathrestChamber.stages.excellent_deathrest_chamber.label>
  <!-- EN: I deathrested in a very impressive chamber. I feel amazing. -->
  <DeathrestChamber.stages.excellent_deathrest_chamber.description>Fiz sono mortal numa câmara muito impressionante. Sinto-me fantástico.</DeathrestChamber.stages.excellent_deathrest_chamber.description>
  <!-- EN: exceptional deathrest chamber -->
  <DeathrestChamber.stages.exceptional_deathrest_chamber.label>câmara de sono mortal excecional</DeathrestChamber.stages.exceptional_deathrest_chamber.label>
  <!-- EN: I deathrested in an extremely impressive chamber. It was glorious. -->
  <DeathrestChamber.stages.exceptional_deathrest_chamber.description>Fiz sono mortal numa câmara extremamente impressionante. Foi glorioso.</DeathrestChamber.stages.exceptional_deathrest_chamber.description>
  <!-- EN: unbelievable deathrest chamber -->
  <DeathrestChamber.stages.unbelievable_deathrest_chamber.label>câmara de sono mortal inacreditável</DeathrestChamber.stages.unbelievable_deathrest_chamber.label>
  <!-- EN: I deathrested in an unbelievably impressive chamber. It was spectacular. -->
  <DeathrestChamber.stages.unbelievable_deathrest_chamber.description>Fiz sono mortal numa câmara incrivelmente impressionante. Foi espetacular.</DeathrestChamber.stages.unbelievable_deathrest_chamber.description>
  <!-- EN: wondrous deathrest chamber -->
  <DeathrestChamber.stages.wondrous_deathrest_chamber.label>câmara de sono mortal maravilhosa</DeathrestChamber.stages.wondrous_deathrest_chamber.label>
  <!-- EN: I deathrested in such a luxurious chamber! It was wondrous. -->
  <DeathrestChamber.stages.wondrous_deathrest_chamber.description>Fiz sono mortal numa câmara tão luxuosa! Foi maravilhoso.</DeathrestChamber.stages.wondrous_deathrest_chamber.description>
  
  <!-- EN: deathrest exhaustion -->
  <DeathrestExhaustion.stages.deathrest_exhaustion.label>exaustão de sono mortal</DeathrestExhaustion.stages.deathrest_exhaustion.label>
  <!-- EN: The casket calls and I fall weary. The world's pall makes all so dreary. I need to deathrest. -->
  <DeathrestExhaustion.stages.deathrest_exhaustion.description>O caixão chama e eu fico cansado. A mortalha do mundo torna tudo tão sombrio. Preciso de fazer sono mortal.</DeathrestExhaustion.stages.deathrest_exhaustion.description>
  
  <!-- EN: apocriton hatred (intense) -->
  <HateAura.stages.apocriton_hatred_intense.label>ódio do apocriton (intenso)</HateAura.stages.apocriton_hatred_intense.label>
  <!-- EN: I feel its hatred inside me, the way I feel my own emotions. It's so close and so cold. They all deserve death. -->
  <HateAura.stages.apocriton_hatred_intense.description>Sinto o seu ódio dentro de mim, como se fossem as minhas próprias emoções. Está tão perto e é tão frio. Todos merecem a morte.</HateAura.stages.apocriton_hatred_intense.description>
  <!-- EN: apocriton hatred (strong) -->
  <HateAura.stages.apocriton_hatred_strong.label>ódio do apocriton (forte)</HateAura.stages.apocriton_hatred_strong.label>
  <!-- EN: I hear its hatred echoing between my thoughts. Reasons, always reasons why my friends ought to die. -->
  <HateAura.stages.apocriton_hatred_strong.description>Ouço o seu ódio a ecoar entre os meus pensamentos. Razões, sempre razões para os meus amigos deverem morrer.</HateAura.stages.apocriton_hatred_strong.description>
  <!-- EN: apocriton hatred (distant) -->
  <HateAura.stages.apocriton_hatred_distant.label>ódio do apocriton (distante)</HateAura.stages.apocriton_hatred_distant.label>
  <!-- EN: I feel it out there somewhere. It's always thinking about why these people deserve death. Always following the logic of murder. Hard to ignore. -->
  <HateAura.stages.apocriton_hatred_distant.description>Sinto-o algures lá fora. Está sempre a pensar em porque é que estas pessoas merecem a morte. Sempre a seguir a lógica do assassínio. É difícil de ignorar.</HateAura.stages.apocriton_hatred_distant.description>
  
  <!-- EN: hemogen craving -->
  <HemogenCraving.stages.hemogen_craving-0.label>desejo de hemogénio</HemogenCraving.stages.hemogen_craving-0.label>
  <!-- EN: My bones ache. I really need hemogen. -->
  <HemogenCraving.stages.hemogen_craving-0.description>Os meus ossos doem. Preciso mesmo de hemogénio.</HemogenCraving.stages.hemogen_craving-0.description>
  <!-- EN: hemogen craving -->
  <HemogenCraving.stages.hemogen_craving-1.label>desejo de hemogénio</HemogenCraving.stages.hemogen_craving-1.label>
  <!-- EN: This hurts bad and my head is fuzzy. I would kill for some blood. Maybe I should. -->
  <HemogenCraving.stages.hemogen_craving-1.description>Isto dói imenso e a minha cabeça está enevoada. Matava por um pouco de sangue. Talvez devesse.</HemogenCraving.stages.hemogen_craving-1.description>
  <!-- EN: hemogen craving -->
  <HemogenCraving.stages.hemogen_craving-2.label>desejo de hemogénio</HemogenCraving.stages.hemogen_craving-2.label>
  <!-- EN: Can't think. Thirst. Thirst. Must. Have. Blood. -->
  <HemogenCraving.stages.hemogen_craving-2.description>Não consigo pensar. Sede. Sede. Preciso. De. Sangue.</HemogenCraving.stages.hemogen_craving-2.description>
  
  <!-- EN: kill thirst -->
  <KillThirst.stages.kill_thirst.label>sede de matar</KillThirst.stages.kill_thirst.label>
  <!-- EN: Must kill... it has been too long since I have killed somebody up close and personal. -->
  <KillThirst.stages.kill_thirst.description>Preciso de matar... já passou demasiado tempo desde que matei alguém de perto, cara a cara.</KillThirst.stages.kill_thirst.description>
  
  <!-- EN: acidic smog -->
  <NoxiousHaze.stages.acidic_smog.label>smog ácido</NoxiousHaze.stages.acidic_smog.label>
  <!-- EN: The smog makes my eyes water and it smells awful. I wish I could just have a few fresh breaths. -->
  <NoxiousHaze.stages.acidic_smog.description>O smog faz-me chorar os olhos e cheira horrivelmente. Quem me dera poder respirar umas golfadas de ar fresco.</NoxiousHaze.stages.acidic_smog.description>
  
  <!-- EN: new pregnancy -->
  <PregnancyAttitude.stages.new_pregnancy-0.label>nova gravidez</PregnancyAttitude.stages.new_pregnancy-0.label>
  <!-- EN: I'm pregnant! It makes me happy. -->
  <PregnancyAttitude.stages.new_pregnancy-0.description>Estou grávida! Faz-me feliz.</PregnancyAttitude.stages.new_pregnancy-0.description>
  <!-- EN: new pregnancy -->
  <PregnancyAttitude.stages.new_pregnancy-1.label>nova gravidez</PregnancyAttitude.stages.new_pregnancy-1.label>
  <!-- EN: I'm pregnant and not very happy about it. -->
  <PregnancyAttitude.stages.new_pregnancy-1.description>Estou grávida e não muito feliz com isso.</PregnancyAttitude.stages.new_pregnancy-1.description>
  
  <!-- EN: collapse -->
  <PregnancyMood_Collapse.labelInBracketsExtraForHediff>colapso</PregnancyMood_Collapse.labelInBracketsExtraForHediff>
  <!-- EN: pregnancy mood collapse -->
  <PregnancyMood_Collapse.stages.pregnancy_mood_collapse.label>colapso de humor da gravidez</PregnancyMood_Collapse.stages.pregnancy_mood_collapse.label>
  <!-- EN: This pregnancy is so hard. My body always feels awful. So exhausting! -->
  <PregnancyMood_Collapse.stages.pregnancy_mood_collapse.description>Esta gravidez é tão difícil. O meu corpo sente-se sempre horrível. É tão exaustivo!</PregnancyMood_Collapse.stages.pregnancy_mood_collapse.description>
  
  <!-- EN: down -->
  <PregnancyMood_Down.labelInBracketsExtraForHediff>em baixo</PregnancyMood_Down.labelInBracketsExtraForHediff>
  <!-- EN: pregnancy mood down -->
  <PregnancyMood_Down.stages.pregnancy_mood_down.label>humor em baixo da gravidez</PregnancyMood_Down.stages.pregnancy_mood_down.label>
  <!-- EN: It feels like everything is going wrong for me today. Pregnancy is tough. -->
  <PregnancyMood_Down.stages.pregnancy_mood_down.description>Parece que hoje tudo me está a correr mal. A gravidez é difícil.</PregnancyMood_Down.stages.pregnancy_mood_down.description>
  
  <!-- EN: high -->
  <PregnancyMood_High.labelInBracketsExtraForHediff>em alta</PregnancyMood_High.labelInBracketsExtraForHediff>
  <!-- EN: pregnancy mood high -->
  <PregnancyMood_High.stages.pregnancy_mood_high.label>humor em alta da gravidez</PregnancyMood_High.stages.pregnancy_mood_high.label>
  <!-- EN: I feel amazing! Being pregnant is a gift! -->
  <PregnancyMood_High.stages.pregnancy_mood_high.description>Sinto-me fantástica! Estar grávida é uma dádiva!</PregnancyMood_High.stages.pregnancy_mood_high.description>
  
  <!-- EN: up -->
  <PregnancyMood_Up.labelInBracketsExtraForHediff>em cima</PregnancyMood_Up.labelInBracketsExtraForHediff>
  <!-- EN: pregnancy mood up -->
  <PregnancyMood_Up.stages.pregnancy_mood_up.label>humor em cima da gravidez</PregnancyMood_Up.stages.pregnancy_mood_up.label>
  <!-- EN: Everything feels a little bit more pleasant today. Pregnancy is nice. -->
  <PregnancyMood_Up.stages.pregnancy_mood_up.description>Hoje tudo parece um pouco mais agradável. A gravidez é bonita.</PregnancyMood_Up.stages.pregnancy_mood_up.description>
  
  <!-- EN: psychic bond -->
  <PsychicBondProximity.stages.psychic_bond.label>ligação psíquica</PsychicBondProximity.stages.psychic_bond.label>
  <!-- EN: The bond brings us together, sharing feelings and thoughts. It's like a friend who is always with me. -->
  <PsychicBondProximity.stages.psychic_bond.description>A ligação aproxima-nos, partilhando sentimentos e pensamentos. É como um amigo que está sempre comigo.</PsychicBondProximity.stages.psychic_bond.description>
  <!-- EN: psychic bond distance -->
  <PsychicBondProximity.stages.psychic_bond_distance.label>distância da ligação psíquica</PsychicBondProximity.stages.psychic_bond_distance.label>
  <!-- EN: The distance makes it so hard to hear. I feel alone, like standing in a dark, silent cavern. -->
  <PsychicBondProximity.stages.psychic_bond_distance.description>A distância torna tão difícil ouvi-lo. Sinto-me sozinho, como se estivesse numa caverna escura e silenciosa.</PsychicBondProximity.stages.psychic_bond_distance.description>
  
  <!-- EN: recluse alone -->
  <Recluse.stages.recluse_alone.label>recluso sozinho</Recluse.stages.recluse_alone.label>
  <!-- EN: It's a relief not to have to think about other people. -->
  <Recluse.stages.recluse_alone.description>É um alívio não ter de pensar em outras pessoas.</Recluse.stages.recluse_alone.description>
  <!-- EN: recluse in small group -->
  <Recluse.stages.recluse_in_small_group.label>recluso em grupo pequeno</Recluse.stages.recluse_in_small_group.label>
  <!-- EN: I'm happy I don't have too many people to think about. Alone would be better, but this is good too. -->
  <Recluse.stages.recluse_in_small_group.description>Estou feliz por não ter muitas pessoas para pensar. Sozinho seria melhor, mas isto também é bom.</Recluse.stages.recluse_in_small_group.description>
  <!-- EN: recluse crowded -->
  <Recluse.stages.recluse_crowded.label>recluso com multidão</Recluse.stages.recluse_crowded.label>
  <!-- EN: There's too many people around here. The weight of having to think about them bears down on me. -->
  <Recluse.stages.recluse_crowded.description>Há demasiadas pessoas por aqui. O peso de ter de pensar nelas esmaga-me.</Recluse.stages.recluse_crowded.description>
  <!-- EN: recluse very crowded -->
  <Recluse.stages.recluse_very_crowded.label>recluso com muita multidão</Recluse.stages.recluse_very_crowded.label>
  <!-- EN: There are so many people I'm supposed to be working with. They're overwhelming. -->
  <Recluse.stages.recluse_very_crowded.description>Há tantas pessoas com quem devia trabalhar. São avassaladoras.</Recluse.stages.recluse_very_crowded.description>
  
  <!-- EN: scanning sickness -->
  <ScanningSickness.stages.scanning_sickness.label>doença da leitura</ScanningSickness.stages.scanning_sickness.label>
  <!-- EN: Ever since that scan I've been dizzy and I can't think. -->
  <ScanningSickness.stages.scanning_sickness.description>Desde aquela leitura que ando tonto e não consigo pensar.</ScanningSickness.stages.scanning_sickness.description>
  
  <!-- EN: sunlight sensitivity -->
  <SunlightSensitivity_Major.stages.sunlight_sensitivity.label>sensibilidade à luz solar</SunlightSensitivity_Major.stages.sunlight_sensitivity.label>
  <!-- EN: The sunlight burns my eyes and my skin feels like it's being scorched. -->
  <SunlightSensitivity_Major.stages.sunlight_sensitivity.description>A luz do sol queima-me os olhos e a pele parece estar a ser chamuscada.</SunlightSensitivity_Major.stages.sunlight_sensitivity.description>
  
  <!-- EN: sunlight sensitivity -->
  <SunlightSensitivity_Mild.stages.sunlight_sensitivity.label>sensibilidade à luz solar</SunlightSensitivity_Mild.stages.sunlight_sensitivity.label>
  <!-- EN: The sun hurts my eyes and my skin is tingling unpleasantly. -->
  <SunlightSensitivity_Mild.stages.sunlight_sensitivity.description>O sol faz-me doer os olhos e a pele tem uma comichão desagradável.</SunlightSensitivity_Mild.stages.sunlight_sensitivity.description>
  
</LanguageData>