<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: Bioferrite generator -->
  <BioferriteGenerator.stages.Bioferrite_generator.label>Gerador de Bioferrite</BioferriteGenerator.stages.Bioferrite_generator.label>
  <!-- EN: The buzz of that blasted machine will make me mad. It's like nails on a chalkboard. -->
  <BioferriteGenerator.stages.Bioferrite_generator.description>O zumbido daquela máquina rebentada vai deixar-me louco. É como pregos num quadro.</BioferriteGenerator.stages.Bioferrite_generator.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-0.label>raiva de sangue</BloodRage.stages.blood_rage-0.label>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-1.label>raiva de sangue</BloodRage.stages.blood_rage-1.label>
  <!-- EN: I'm really angry. I feel like I could hit someone. -->
  <BloodRage.stages.blood_rage-1.description>Estou mesmo zangado. Sinto que posso bater em alguém.</BloodRage.stages.blood_rage-1.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-2.label>raiva de sangue</BloodRage.stages.blood_rage-2.label>
  <!-- EN: I want to hurt something. I want to hurt something so much. -->
  <BloodRage.stages.blood_rage-2.description>Quero magoar alguma coisa. Quero magoar tanto.</BloodRage.stages.blood_rage-2.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-3.label>raiva de sangue</BloodRage.stages.blood_rage-3.label>
  <!-- EN: Smash everything into pieces! You all deserve it! -->
  <BloodRage.stages.blood_rage-3.description>Espalhe tudo em pedaços! Todos merecem!</BloodRage.stages.blood_rage-3.description>
  <!-- EN: blood rage -->
  <BloodRage.stages.blood_rage-4.label>raiva de sangue</BloodRage.stages.blood_rage-4.label>
  <!-- EN: I'll destroy you! I'll kill you! -->
  <BloodRage.stages.blood_rage-4.description>Vou destruir-te! Eu mato-te!</BloodRage.stages.blood_rage-4.description>
  <!-- EN: cube sculpture -->
  <CubeSculptures.stages.cube_sculpture.label>escultura de cubo</CubeSculptures.stages.cube_sculpture.label>
  <!-- EN: My sculpture... my beautiful sculpture! -->
  <CubeSculptures.stages.cube_sculpture.description>A minha escultura... a minha bela escultura!</CubeSculptures.stages.cube_sculpture.description>
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-0.label>retirada do cubo</CubeWithdrawl.stages.cube_withdrawal-0.label>
  <!-- EN: I need to see the golden cube. Just once more. Please. -->
  <CubeWithdrawl.stages.cube_withdrawal-0.description>Preciso de ver o cubo dourado. Só mais uma vez. Por favor.</CubeWithdrawl.stages.cube_withdrawal-0.description>
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-1.label>retirada do cubo</CubeWithdrawl.stages.cube_withdrawal-1.label>
  <!-- EN: Where's that cube? I miss it. I need it! -->
  <CubeWithdrawl.stages.cube_withdrawal-1.description>Onde está o cubo? Tenho saudades. Preciso!</CubeWithdrawl.stages.cube_withdrawal-1.description>
  <!-- EN: cube withdrawal -->
  <CubeWithdrawl.stages.cube_withdrawal-2.label>retirada do cubo</CubeWithdrawl.stages.cube_withdrawal-2.label>
  <!-- EN: Where is my cube? Where is it? -->
  <CubeWithdrawl.stages.cube_withdrawal-2.description>Onde está o meu cubo? Onde está?</CubeWithdrawl.stages.cube_withdrawal-2.description>
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-0.label>poeira morta</DeadlifeDust.stages.deadlife_dust-0.label>
  <!-- EN: This dust itches bad. -->
  <DeadlifeDust.stages.deadlife_dust-0.description>Esta poeira coça mal.</DeadlifeDust.stages.deadlife_dust-0.description>
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-1.label>poeira morta</DeadlifeDust.stages.deadlife_dust-1.label>
  <!-- EN: I'm breaking out in rashes from this dust. It's burning my skin. -->
  <DeadlifeDust.stages.deadlife_dust-1.description>Estou a sair em erupções desta poeira. Está a queimar-me a pele.</DeadlifeDust.stages.deadlife_dust-1.description>
  <!-- EN: deadlife dust -->
  <DeadlifeDust.stages.deadlife_dust-2.label>poeira morta</DeadlifeDust.stages.deadlife_dust-2.label>
  <!-- EN: This dust stings! I can feel it in my eyes and lungs. -->
  <DeadlifeDust.stages.deadlife_dust-2.description>Estas picadas de pó! Consigo senti-lo nos meus olhos e pulmões.</DeadlifeDust.stages.deadlife_dust-2.description>
  <!-- EN: death pall -->
  <DeathPall.stages.death_pall.label>palha de morte</DeathPall.stages.death_pall.label>
  <!-- EN: It smells like death. -->
  <DeathPall.stages.death_pall.description>Cheira a morte.</DeathPall.stages.death_pall.description>
  <!-- EN: death pall exposure -->
  <DeathPall.stages.death_pall_exposure.label>exposição de palha de morte</DeathPall.stages.death_pall_exposure.label>
  <!-- EN: It smells like death. My eyes sting and the air grits between my teeth. -->
  <DeathPall.stages.death_pall_exposure.description>Cheira a morte. Os meus olhos picam e as argamassas entre os meus dentes.</DeathPall.stages.death_pall_exposure.description>
  <!-- EN: death refusal -->
  <DeathRefusalSickness.stages.death_refusal.label>recusa</DeathRefusalSickness.stages.death_refusal.label>
  <!-- EN: I was dead… I died. It was cold and terrifying. -->
  <DeathRefusalSickness.stages.death_refusal.description>Eu estava morto... Eu morri. Era frio e aterrorizante.</DeathRefusalSickness.stages.death_refusal.description>
  <!-- EN: my cube sculpture destroyed -->
  <DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.label>minha escultura de cubo destruído</DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.label>
  <!-- EN: My sculpture... my beautiful sculpture... -->
  <DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.description>A minha escultura... a minha bela escultura...</DestroyedCubeSculpture.stages.my_cube_sculpture_destroyed.description>
  <!-- EN: monster by my bed -->
  <EntityInRoom.stages.monster_by_my_bed.label>monstro à minha cama</EntityInRoom.stages.monster_by_my_bed.label>
  <!-- EN: I'll never be able to sleep with that twisted thing around! -->
  <EntityInRoom.stages.monster_by_my_bed.description>Nunca conseguirei dormir com aquela coisa torcida!</EntityInRoom.stages.monster_by_my_bed.description>
  <!-- EN: flesh tentacle -->
  <FleshTentacle.stages.flesh_tentacle.label>tentáculos de carne</FleshTentacle.stages.flesh_tentacle.label>
  <!-- EN: Get this thing off of me! -->
  <FleshTentacle.stages.flesh_tentacle.description>Tira-me esta coisa!</FleshTentacle.stages.flesh_tentacle.description>
  <!-- EN: flesh whip -->
  <FleshWhip.stages.flesh_whip.label>chicote de carne</FleshWhip.stages.flesh_whip.label>
  <!-- EN: It never stops squirming. I hate it. -->
  <FleshWhip.stages.flesh_whip.description>Nunca pára de esguichar. Odeio.</FleshWhip.stages.flesh_whip.description>
  <!-- EN: gray pall -->
  <GrayPall.stages.gray_pall.label>palhaço cinza</GrayPall.stages.gray_pall.label>
  <!-- EN: It feels like the world is sick and dying. -->
  <GrayPall.stages.gray_pall.description>Parece que o mundo está doente e a morrer.</GrayPall.stages.gray_pall.description>
  <!-- EN: gray pall exposure -->
  <GrayPall.stages.gray_pall_exposure.label>exposição de palha cinza</GrayPall.stages.gray_pall_exposure.label>
  <!-- EN: It feels like the world is sick and dying. The putrid air makes me want to vomit. -->
  <GrayPall.stages.gray_pall_exposure.description>Parece que o mundo está doente e a morrer. O ar púbico faz-me querer vomitar.</GrayPall.stages.gray_pall_exposure.description>
  <!-- EN: harbinger tree scream -->
  <HarbingerScream.stages.harbinger_tree_scream.label>harbinger árvore grito</HarbingerScream.stages.harbinger_tree_scream.label>
  <!-- EN: I've had a pounding headache ever since that tree died. I can still hear it... -->
  <HarbingerScream.stages.harbinger_tree_scream.description>Tive dores de cabeça desde que a árvore morreu. Ainda consigo ouvir...</HarbingerScream.stages.harbinger_tree_scream.description>
  <!-- EN: hate chant whispers -->
  <HateChantDrone.stages.hate_chant_whispers.label>o ódio sussurra cantos</HateChantDrone.stages.hate_chant_whispers.label>
  <!-- EN: I hear their whispers, no matter where I am. Saying wrong things to me over and over. -->
  <HateChantDrone.stages.hate_chant_whispers.description>Ouvi os sussurros deles, não importa onde eu esteja. Dizer coisas erradas para mim repetidamente.</HateChantDrone.stages.hate_chant_whispers.description>
  <!-- EN: quiet hate chanting -->
  <HateChantDrone.stages.quiet_hate_chanting.label>silêncio ódio cantando</HateChantDrone.stages.quiet_hate_chanting.label>
  <!-- EN: I can hear them muttering, filling my mind with hatred, inside my head. -->
  <HateChantDrone.stages.quiet_hate_chanting.description>Consigo ouvi-los a murmurar, a encher a minha mente de ódio, dentro da minha cabeça.</HateChantDrone.stages.quiet_hate_chanting.description>
  <!-- EN: hate chanting -->
  <HateChantDrone.stages.hate_chanting.label>odiando canto</HateChantDrone.stages.hate_chanting.label>
  <!-- EN: Those words being screamed into me, muttered, guttural moans of rage. Inside my head. It's driving me mad! -->
  <HateChantDrone.stages.hate_chanting.description>Essas palavras sendo gritadas em mim, muttered, gemidos gutural de raiva. Dentro da minha cabeça. Está a irritar-me!</HateChantDrone.stages.hate_chanting.description>
  <!-- EN: loud hate chanting -->
  <HateChantDrone.stages.loud_hate_chanting.label>alto ódio cantando</HateChantDrone.stages.loud_hate_chanting.label>
  <!-- EN: The screaming doesn't stop, the chanting, inside me, in my head! -->
  <HateChantDrone.stages.loud_hate_chanting.description>Os gritos não param, o canto, dentro de mim, na minha cabeça!</HateChantDrone.stages.loud_hate_chanting.description>
  <!-- EN: extreme hate chanting -->
  <HateChantDrone.stages.extreme_hate_chanting.label>extrema ódio cantando</HateChantDrone.stages.extreme_hate_chanting.label>
  <!-- EN: Rage in my head murderous rip the skin deserves it the black ocean terror deep... -->
  <HateChantDrone.stages.extreme_hate_chanting.description>Rir na minha cabeça assassino rasgar a pele merece o terror do oceano negro profundamente...</HateChantDrone.stages.extreme_hate_chanting.description>
  <!-- EN: imprisoned with entity -->
  <ImprisonedWithEntity.stages.imprisoned_with_entity.label>preso com entidade</ImprisonedWithEntity.stages.imprisoned_with_entity.label>
  <!-- EN: I'm trapped in here with that twisted thing! -->
  <ImprisonedWithEntity.stages.imprisoned_with_entity.description>Estou preso aqui com aquela coisa torcida!</ImprisonedWithEntity.stages.imprisoned_with_entity.description>
  <!-- EN: Joyous presence -->
  <JoyousPresence.stages.Joyous_presence.label>Presença alegre</JoyousPresence.stages.Joyous_presence.label>
  <!-- EN: Wherever I go, I can feel the joyous one in the back of my mind. It makes me feel good. Very good. -->
  <JoyousPresence.stages.Joyous_presence.description>Onde quer que vá, posso sentir a alegria na parte de trás da minha mente. Faz-me sentir bem. Muito bem.</JoyousPresence.stages.Joyous_presence.description>
  <!-- EN: juggernaut serum -->
  <JuggernautSerum.stages.juggernaut_serum.label>soro de soro</JuggernautSerum.stages.juggernaut_serum.label>
  <!-- EN: This stuff messes with my head. I can't stop thinking the worst things. -->
  <JuggernautSerum.stages.juggernaut_serum.description>Isto mete-me na cabeça. Não consigo parar de pensar nas piores coisas.</JuggernautSerum.stages.juggernaut_serum.description>
  <!-- EN: neurosis pulse -->
  <NeurosisPulse.stages.neurosis_pulse.label>pulso de neurose</NeurosisPulse.stages.neurosis_pulse.label>
  <!-- EN: Leave me alone! I have work to do! -->
  <NeurosisPulse.stages.neurosis_pulse.description>Deixa-me em paz! Tenho trabalho a fazer!</NeurosisPulse.stages.neurosis_pulse.description>
  <!-- EN: pleasure pulse -->
  <PleasurePulse.stages.pleasure_pulse.label>pulso de prazer</PleasurePulse.stages.pleasure_pulse.label>
  <!-- EN: My body ripples with joy. The world is a soft and fuzzy place. -->
  <PleasurePulse.stages.pleasure_pulse.description>O meu corpo recarrega com alegria. O mundo é um lugar macio e fuzzy.</PleasurePulse.stages.pleasure_pulse.description>
  <!-- EN: Fascinating tome -->
  <ReadingTome.stages.Fascinating_tome.label>Tome fascinante</ReadingTome.stages.Fascinating_tome.label>
  <!-- EN: Its almost as if it's speaking out to me personally. -->
  <ReadingTome.stages.Fascinating_tome.description>É quase como se estivesse a falar comigo pessoalmente.</ReadingTome.stages.Fascinating_tome.description>
  <!-- EN: Sleep suppressor -->
  <SleepSuppressor.stages.Sleep_suppressor.label>Supressor de sono</SleepSuppressor.stages.Sleep_suppressor.label>
  <!-- EN: The hum of that devilish device grates. I feel it inside my head. What an evil piece of machinery. -->
  <SleepSuppressor.stages.Sleep_suppressor.description>O zumbido daquele dispositivo diabólico rala. Sinto-o dentro da minha cabeça. Que maquinário maligno.</SleepSuppressor.stages.Sleep_suppressor.description>
  <!-- EN: unsettling conversation -->
  <SpokeToDisturbingMood.stages.unsettling_conversation.label>conversa inquietante</SpokeToDisturbingMood.stages.unsettling_conversation.label>
  <!-- EN: An unsettling conversation made me very creeped out. Nobody should think or speak of such things. -->
  <SpokeToDisturbingMood.stages.unsettling_conversation.description>Uma conversa inquieta fez-me ficar muito assustada. Ninguém deve pensar ou falar dessas coisas.</SpokeToDisturbingMood.stages.unsettling_conversation.description>
  <!-- EN: swallowed by darkness -->
  <SwallowedByDarkness.stages.swallowed_by_darkness.label>engolido pela escuridão</SwallowedByDarkness.stages.swallowed_by_darkness.label>
  <!-- EN: The darkness is suffocating. I can't see or think! -->
  <SwallowedByDarkness.stages.swallowed_by_darkness.description>A escuridão está sufocando. Não consigo ver nem pensar!</SwallowedByDarkness.stages.swallowed_by_darkness.description>
  <!-- EN: unnatural corpse -->
  <UnnaturalCorpse.stages.unnatural_corpse.label>corpo natural</UnnaturalCorpse.stages.unnatural_corpse.label>
  <!-- EN: Wherever I go, I can feel it watching me. It never stops. -->
  <UnnaturalCorpse.stages.unnatural_corpse.description>Onde quer que vá, sinto-o a observar-me. Nunca pára.</UnnaturalCorpse.stages.unnatural_corpse.description>
  <!-- EN: unnatural darkness -->
  <UnnaturalDarkness.stages.unnatural_darkness.label>escuridão natural</UnnaturalDarkness.stages.unnatural_darkness.label>
  <!-- EN: I am suffocated under a blanket of darkness. -->
  <UnnaturalDarkness.stages.unnatural_darkness.description>Estou sufocado debaixo de um cobertor de escuridão.</UnnaturalDarkness.stages.unnatural_darkness.description>
  <!-- EN: unnatural sky -->
  <UnnaturalDarkness.stages.unnatural_sky.label>céu natural</UnnaturalDarkness.stages.unnatural_sky.label>
  <!-- EN: The truth finally comes and swallows this false world. -->
  <UnnaturalDarkness.stages.unnatural_sky.description>A verdade finalmente vem e engoli este mundo falso.</UnnaturalDarkness.stages.unnatural_sky.description>
  <!-- EN: captured entity -->
  <VoidFascination.stages.captured_entity.label>entidade capturada</VoidFascination.stages.captured_entity.label>
  <!-- EN: Such a magnificent creature. So much mystery. So much power. -->
  <VoidFascination.stages.captured_entity.description>Uma criatura tão magnífica. Tanto mistério. Tanto poder.</VoidFascination.stages.captured_entity.description>
  <!-- EN: void pleasure -->
  <VoidPleasure.stages.void_pleasure.label>prazer vazio</VoidPleasure.stages.void_pleasure.label>
  <!-- EN: The vibrations of reality pulse into me and soothe everything. -->
  <VoidPleasure.stages.void_pleasure.description>As vibrações da realidade pulsam em mim e acalmam tudo.</VoidPleasure.stages.void_pleasure.description>
  <!-- EN: voidsight -->
  <Voidsight.stages.voidsight.label>visão do vazio</Voidsight.stages.voidsight.label>
  <!-- EN: The serum makes me see so much more. Connections everywhere, emotions flowing. Faces in the shadows. So much... -->
  <Voidsight.stages.voidsight.description>O soro faz-me ver muito mais. Conexões em todo lugar, emoções fluindo. Caras nas sombras. Tanto...</Voidsight.stages.voidsight.description>
  <!-- EN: dread leather {0} -->
  <WearingDreadLeather.stages.dread_leather.label>couro de rosa não</WearingDreadLeather.stages.dread_leather.label>
  <!-- EN: I hate this stuff. It stinks. -->
  <WearingDreadLeather.stages.dread_leather.description>Odeio isto. Cheira mal.</WearingDreadLeather.stages.dread_leather.description>
  <!-- EN: dread leather {0} (+1) -->
  <WearingDreadLeather.stages.dread_leather_1.label>dread couro {0} (+1)</WearingDreadLeather.stages.dread_leather_1.label>
  <!-- EN: Two dread leather items. These make me uncomfortable. -->
  <WearingDreadLeather.stages.dread_leather_1.description>Dois artigos de couro. Isto deixa-me desconfortável.</WearingDreadLeather.stages.dread_leather_1.description>
  <!-- EN: dread leather {0} (+2) -->
  <WearingDreadLeather.stages.dread_leather_2.label>dread couro (0} (+2)</WearingDreadLeather.stages.dread_leather_2.label>
  <!-- EN: These three dread leather items make me squirm. They smell awful. -->
  <WearingDreadLeather.stages.dread_leather_2.description>Estes três artigos de couro dread fazem-me esguichar. Cheiram mal.</WearingDreadLeather.stages.dread_leather_2.description>
  <!-- EN: dread leather {0} etc -->
  <WearingDreadLeather.stages.dread_leather_etc.label>dread couro {0} etc</WearingDreadLeather.stages.dread_leather_etc.label>
  <!-- EN: I'm covered in this horrible stuff. -->
  <WearingDreadLeather.stages.dread_leather_etc.description>Estou coberto de coisas horríveis.</WearingDreadLeather.stages.dread_leather_etc.description>
</LanguageData>
