  <!-- EN: activating obelisk: {1}s -->
  <WarpedObelisk_Labyrinth.comps.CompObelisk_Labyrinth.activatingString>ativando obelisco: não</WarpedObelisk_Labyrinth.comps.CompObelisk_Labyrinth.activatingString>
